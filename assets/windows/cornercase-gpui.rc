1 ICON "cornercase-gpui.ico"
1 24 "cornercase-gpui.manifest"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "cornercase"
            VALUE "ProductName", "cornercase"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "ProductVersion", VERSION_TEXT
            VALUE "InternalName", "cornercase-gpui"
            VALUE "OriginalFilename", "cornercase-gpui.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
