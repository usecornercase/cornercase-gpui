---
import Mark from './Mark.astro';
import { CORNERCASE, DISCORD, DOCS, RELEASES, REPO } from '../data/links';
---

<footer class="foot">
  <div class="foot__brand"><Mark size={22} /><span>cornercase <i>gpui</i></span></div>
  <nav class="foot__links" aria-label="More">
    <a href={REPO}>GitHub</a>
    <a href={RELEASES}>Releases</a>
    <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a>
    <a href={CORNERCASE}>cornercase</a>
    <a href={DOCS}>Docs</a>
    <a href={DISCORD}>Discord</a>
  </nav>
  <p class="foot__small">Licensed under MIT or Apache-2.0. Drawn with <a href="https://gpui.rs">GPUI</a>, by Zed Industries. Icons by Lucide (<a href={`${REPO}/blob/main/assets/icons/LICENSE`}>ISC</a>) and Seti UI (<a href={`${REPO}/blob/main/assets/file-icons/LICENSE`}>MIT</a>); text set in Archivo and JetBrains Mono, under the SIL Open Font License. The projects on this page are made up.</p>
</footer>
<div class="hud" data-hud aria-hidden="true"><i></i><span data-hud-fps>–</span> fps on your GPU</div>
