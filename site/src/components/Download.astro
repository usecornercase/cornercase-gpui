---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { DOCS, DOWNLOAD, FILES, INSTALLS, RELEASES, REPO } from '../data/links';

const platforms = [
  { id: 'mac', name: 'macOS', file: FILES.mac, facts: ['macOS 12 or later', 'Apple silicon or Intel', 'Signed and notarized by Apple'], asks: 'Open it and drag cornercase to Applications.' },
  { id: 'windows', name: 'Windows', file: FILES.windows, facts: ['Windows 10 or 11, x64', 'No runtime to install', 'Needs cornercase 0.13.1 or newer'], asks: 'Not signed yet: SmartScreen asks the first time, and Smart App Control blocks it.' },
  { id: 'linux', name: 'Linux', file: FILES.linux, facts: ['x86_64, glibc 2.35 or newer', 'X11 or Wayland, with Vulkan', 'Updates itself in place'], asks: 'Not signed yet. Your system may ask the first time.' },
];
---

<section class="download" id="download" data-section="download">
  <div class="download__head">
    <Mark size={44} class="download__mark" />
    <h2 data-download-title>Give your agents a window.</h2>
    <p>Free and open source, MIT or Apache-2.0. It tells you when a new version is out, and updating it never touches your agents.</p>
  </div>
  <div class="platforms">
    {
      platforms.map((platform) => (
        <a class="platform" href={`${DOWNLOAD}/${platform.file}`} data-platform={platform.id}>
          <span class="platform__tag">Your system</span>
          <h3>{platform.name}</h3>
          <ul>{platform.facts.map((fact) => <li>{fact}</li>)}</ul>
          <span class="platform__asks">{platform.asks}</span>
          <span class="platform__go"><Icon name="download" size={15} /> <span class="platform__file">{platform.file.split('.').slice(1).join('.')}</span><span class="platform__size" data-size={platform.file}></span></span>
        </a>
      ))
    }
  </div>
  <p class="download__more"><a href={RELEASES}>Every download, its checksum and what changed</a> · <a href={`${REPO}#build-from-source`}>Build from source</a><span data-version></span></p>
  <div class="need">
    <div class="need__text">
      <h3>It needs cornercase</h3>
      <p>cornercase 0.13.1 or newer, which keeps your agents running. The window finds it by itself, and says so if it is missing. <a href={DOCS}>Installation guide</a></p>
    </div>
    <div class="install" data-install>
      <div class="install__ways" role="group" aria-label="How to install cornercase">
        {INSTALLS.map(([label], i) => <button type="button" class="install__way" aria-pressed={i === 0 ? 'true' : 'false'} data-way={i}>{label}</button>)}
      </div>
      {
        INSTALLS.map(([label, command], i) => (
          <div class:list={['install__line', i === 0 && 'is-on']} data-line={i}>
            <span class="install__name">{label}</span>
            <span class="install__ps" aria-hidden="true">$</span>
            <code>{command}</code>
            <button type="button" class="install__copy" data-copy={command}>
              <span class="install__idle">copy</span>
              <span class="install__done">copied</span>
            </button>
          </div>
        ))
      }
      <p class="install__status" role="status" data-copy-status></p>
    </div>
  </div>
</section>
